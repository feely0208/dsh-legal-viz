{
  "name": "@deepwhale-cn/dsh-legal-viz",
  "version": "0.3.0",
  "description": "深鲸诉讼可视化：把案情与证据 JSON 画成时间轴、法律关系图、证据矩阵、争点对照，输出可打印的单文件 HTML。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "legal",
    "法律",
    "诉讼可视化",
    "timeline",
    "evidence-matrix",
    "panel"
  ],
  "files": [
    "lib",
    "bin",
    "skill",
    "cordis.patch.yml",
    "tests/fixtures",
    "README.md",
    "LICENSE"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-legal-viz": "./bin/cli.mjs"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6 <0.3.0",
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "@deepwhale-cn/dsh-guard-core": "^0.10.1"
  },
  "author": "温州深鲸智能科技有限公司 <contact@deepwhale.org.cn>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feely0208/dsh-legal-viz.git"
  },
  "homepage": "https://www.deepwhale.org.cn/legal.html",
  "bugs": {
    "url": "https://github.com/feely0208/dsh-legal-viz/issues"
  }
}
